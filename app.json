{
  "expo": {
    "name": "Sahla4Eco",
    "slug": "ssahla4eco",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sahla4eco",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "updates": {
      "url": "https://u.expo.dev/b04eda9f-9b33-4353-92c1-177264fd8468"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "20",
      "supportsTablet": false,
      "bundleIdentifier": "com.sahla4eco.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR code to log in to your store dashboard.",
        "NSFaceIDUsageDescription": "Unlock the app with Face ID for quick access."
      }
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.sahla4eco.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "buildNumber": 20,
      "eas": {
        "projectId": "b04eda9f-9b33-4353-92c1-177264fd8468"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-asset",
      "expo-updates",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sahla4Eco to access your camera to scan QR codes for login."
        }
      ]
    ],
    "owner": "sahla4eco-organization",
    "runtimeVersion": "1.0.0"
  }
}
